# Pokemon LLM Environment Variables
# Copy this file to .env and fill in your API keys

# Game ROM Configuration (ROMs should be placed in roms/ folder)
POKEMON_ROM=red-patched.gb

# ═══════════════════════════════════════════════════════════════════════════
# Base LLM Configuration
# ═══════════════════════════════════════════════════════════════════════════
LLM_PROVIDER="OPENCODE" # OPENAI, GEMINI, OLLAMA, LMSTUDIO, GROQ, TOGETHER, GROK, ANTHOPIC, ZAI, ZAI_DIRECT, OPENCODE

OPENCODE_MODEL=opencode/grok-code
VISION_PROVIDER=COMFYUI
LLM_SUPPORTS_VISION=false

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=o3

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Anthropic Claude
ANTHOPIC_API_KEY=your_anthropic_api_key_here
ANTHOPIC_MODEL=claude-sonnet-4-20250514

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# xAI Grok
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-3-mini

# Together AI
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# Z.AI (GLM) with MCP Vision Server Support
Z_AI_API_KEY=your_z_ai_api_key_here
Z_AI_MODEL=glm-4.6
Z_AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
Z_AI_DIRECT_MODEL=glm-4.6v-flash
Z_AI_MODE=ZAI
# ZAI Thinking Mode: "enabled" or "disabled" (enhanced reasoning for complex decisions)
Z_AI_THINKING_MODE=enabled
# ZAI MCP Server: "true" or "false" (uses Z_AI_DIRECT_MODEL if disabled)
Z_AI_MCP_DISABLED=true

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:27b-it-q4_K_M

# LM Studio (Local)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-3-27b

# Additional Configuration
REASONING_EFFORT=high
ONE_IMAGE_PER_PROMPT=true
MINIMAP_ENABLED=true
MINIMAP_2D=true
REASONING_ENABLED=true
MAX_TOKENS=2048
TEMPERATURE=0.7
IMAGE_DETAIL=high

# ═══════════════════════════════════════════════════════════════════════════
# Text-to-Speech (Chatterbox) Configuration
# ═══════════════════════════════════════════════════════════════════════════

TTS_ENABLED=true
# TTS Audio Speed (1.1 = 10% faster)
TTS_AUDIO_SPEED=1.1
# TTS Audio Pitch (in semitones, 2 = higher pitch)
TTS_AUDIO_PITCH=0.25

# Selfhosted ComfyUI (hosting Chatterbox TTS)
COMFYUI_URL=https://comfyui.example.com
COMFYUI_TTS_WORKFLOW=workflows/lass-tts.json
COMFYUI_OUTPUT_DIR=tts_output
# ComfyUI Basic Auth (for hosted instances)
COMFYUI_USERNAME=your_comfyui_username
COMFYUI_PASSWORD=your_comfyui_password

# ═══════════════════════════════════════════════════════════════════════════
# Stream Chat Response Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Test LLM Responses for Chat Messages
CHAT_TEST_LLM=true
# Send Test Messages to the LLM
CHAT_TEST_MODE=true
# Available Chat Providers: featherless, alkahest, ollama, lmstudio, zai, zai_direct
LLM_CHAT_PROVIDER=featherless

# ═══════════════════════════════════════════════════════════════════════════
# CHAT RESPONSE API
# ═══════════════════════════════════════════════════════════════════════════
# Chat Response API (separate from main LLM)
# Required for real Twitch chat responses - uses LLM to generate witty replies
# Uses Featherless AI for local/development, Alkahest for production
FEATHERLESS_API_KEY=rc_165db6f601eddf447352a9399a90664f9a62ca5632e24c632798db656c2fc297
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=zai-org/GLM-4.6

STREAM_COUNTDOWN_SECONDS=10

# ═══════════════════════════════════════════════════════════════════════════
# Stream Chat Response Configuration (Twitch)
# ═══════════════════════════════════════════════════════════════════════════
# When enabled, generates fake chat messages for testing the SKIP/RESPOND system
# Works completely OFFLINE without any Twitch or Featherless/Alkahest API keys!
#
# Set TWITCH_TEST_MODE=true to:
# - Generate fake messages with Pokemon-themed usernames
# - Test SKIP/RESPOND logic with mock decisions (30% skip rate + spam detection)
# - See "🧪 Twitch TEST MODE enabled!" in logs
#
TWITCH_TEST_MODE=true
TWITCH_TEST_MESSAGES_PER_CYCLE=10
TWITCH_TEST_LLM=true

# (Twitch) Chat Integration
TWITCH_BOT_USERNAME=Lass
TWITCH_OAUTH_TOKEN=your_twitch_oauth_token_here
TWITCH_CHANNEL=LLMLetsPlay
# (Twitch) Chat Engagement Features
TWITCH_ENABLE_POLLS=false
TWITCH_ENABLE_CHANNEL_POINTS=false
TWITCH_ENABLE_PREDICTIONS=false
TWITCH_ENABLE_CHAT_MEMORY=true


# ═══════════════════════════════════════════════════════════════════════════
# PUMP.FUN LIVESTREAM CHAT - Crypto token chat integration
# ═══════════════════════════════════════════════════════════════════════════
# Connects to pump.fun token chat rooms via WebSocket
# Reading messages: No auth required
# Sending messages: Requires pump.fun session cookies (not implemented yet)
#
# PUMPFUN_TOKEN_ADDRESS: Your token's contract address on pump.fun
# Example: y31hFyYbrVW4R53Zfka8WJfQpwpMLfCcAjVKAonpump
#
PUMPFUN_TOKEN_ADDRESS=

# ═══════════════════════════════════════════════════════════════════════════
# PUMP.FUN TEST MODE - For testing without real pump.fun connection
# ═══════════════════════════════════════════════════════════════════════════
# Generates fake crypto-themed chat messages for testing
# Works OFFLINE without any pump.fun connection!
#
# PUMPFUN_TEST_MODE=true  → Fake messages with crypto usernames (DiamondHands, etc)
# PUMPFUN_TEST_MODE=false → Real pump.fun WebSocket connection
#
PUMPFUN_TEST_MODE=true

# ═══════════════════════════════════════════════════════════════════════════
# CHAT RESPONSE PRIORITY HIERARCHY
# ═══════════════════════════════════════════════════════════════════════════
# When multiple chat messages come in, priority order is:
#
# 1. 👑 Pump.fun WHALE holders (100k+ tokens) - Highest priority
# 2. 💎 Twitch subscribers
# 3. 🪙 Regular pump.fun chatters
# 4. 👤 Regular Twitch chatters - Lowest priority
#
# Token threshold for whale status (set to 0 to disable whale priority):
PUMPFUN_WHALE_THRESHOLD=100000

# Cache TTL for whale status (in seconds)
# Longer = fewer API calls but slower to detect balance changes
# Default 15 min (900s) is good for streams since users stick around
WHALE_CACHE_TTL=900


# ═══════════════════════════════════════════════════════════════════════════
# X/TWITTER API (Free Tier - 500 posts/month)
# ═══════════════════════════════════════════════════════════════════════════
# Get credentials from: https://developer.x.com/en/portal/dashboard
# Required: OAuth 1.0a User Context for posting tweets
# See docs/TWITTER_SETUP.md for detailed setup instructions
#
TWITTER_ENABLED=true
TWITTER_API_KEY=p1HCZaCAt3rwDKSOnM4h9IKnv
TWITTER_API_SECRET=zaB3qdh8D8tv343vUD45EitV2yit45SbW0gsHUS8L537kraxec
TWITTER_ACCESS_TOKEN=1999642009099993091-CbrBM8DshBOafhn3vO80DJWoxeqMwd
TWITTER_ACCESS_TOKEN_SECRET=kPG0endP3MlyClRn7ZUHPXeXwgGBs7bxcc44QfidLbA2y

# ═══════════════════════════════════════════════════════════════════════════
# DISCORD APPROVAL BOT
# ═══════════════════════════════════════════════════════════════════════════
# Create bot at: https://discord.com/developers/applications
# Required permissions: Send Messages, Add Reactions, Read Message History,
#                       Embed Links, Attach Files
# See docs/DISCORD_SETUP.md for detailed setup instructions
#
# Approval Emojis:
#   ✅ Approve    - Post tweet to X
#   ❌ Deny       - Skip this tweet
#   🔄 Regen All  - Regenerate image + text
#   🖼️ Regen Img  - Regenerate image only
#   📝 Regen Text - Regenerate text only
#
DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPROVAL_CHANNEL_ID=your_discord_approval_channel_id_here
DISCORD_APPROVAL_TIMEOUT=900
DISCORD_APPROVAL_THRESHOLD=1
DISCORD_MAX_REGENERATIONS=3

# ═══════════════════════════════════════════════════════════════════════════
# COMFYUI IMAGE GENERATION (Tweet Images)
# ═══════════════════════════════════════════════════════════════════════════
# Uses same COMFYUI_URL as TTS
# Generates 1024x1024 images for tweet attachments
#
COMFYUI_IMAGE_WORKFLOW=workflows/lass-image-gen.json
COMFYUI_IMAGE_OUTPUT_DIR=tweet_images


# ═══════════════════════════════════════════════════════════════════════════
# ZORA / LLMLetsPlay BRAND INTEGRATION
# ═══════════════════════════════════════════════════════════════════════════
#
# Zora API (for chat and posting)
# Get from https://zora.co/settings/developer
ZORA_API_KEY=

# Zora Livestream Chat
ZORA_USERNAME=your_zora_sidecar_url_here
ZORA_CHAT_ENABLED=true

# Zora Posting (via Chronicle Server)
ZORA_SIDECAR_URL=http://localhost:8787
ZORA_POSTING_ENABLED=true
ZORA_AUTO_POST=true
ZORA_MIN_POST_INTERVAL=300

# Exclusive Content Gating (Chronicle)
ZORA_GATING_ENABLED=false # Set to true to enable exclusive content drops

# Zora Wallet (for sidecar minting)
ZORA_CREATOR_ADDRESS=
ZORA_PRIVATE_KEY=

# Base Token Detection (LLMLetsPlay token on Base)
BASE_TOKEN_ADDRESS=
BASE_RPC_URL=https://mainnet.base.org
BASE_WHALE_THRESHOLD=10000
ALCHEMY_BASE_API_KEY=

# Chronicle Agent Auth (Must match server .env)
# ----------------------------------------------
# 1. Used to authenticate internal requests (Draft Creation)
CHRONICLE_SECRET_KEY=change_me_to_a_secure_random_string

# Cloudflare Zero Trust (Access) Configuration
# ----------------------------------------------
# 1. Create a Service Token in Cloudflare Zero Trust > Access > Service Auth.
# 2. Add policies to your Worker to allow this token.
# 3. Add the Client ID and Secret below.

# Cloudflare Access Service Token (for Zero Trust)
CF_ACCESS_CLIENT_ID=your_cloudflare_access_client_id_here
CF_ACCESS_CLIENT_SECRET=your_cloudflare_access_client_secret_here
