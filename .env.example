# Pokemon LLM Environment Variables
# Copy this file to .env and fill in your API keys and ROM path

# Game ROM Configuration (ROMs should be placed in roms/ folder)
POKEMON_ROM=red.gb

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=o3

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Anthropic Claude
ANTHOPIC_API_KEY=your_anthropic_api_key_here
ANTHOPIC_MODEL=claude-sonnet-4-20250514

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# xAI Grok
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-3-mini

# Together AI
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# Z.AI (GLM) with MCP Vision Server Support
ZAI_API_KEY=your_zai_api_key_here
ZAI_MODEL=glm-4.6
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# ZAI Thinking Mode: "enabled" or "disabled" (enhanced reasoning for complex decisions)
ZAI_THINKING_MODE=enabled

# Z.AI Direct Mode (Combined Vision+Text in single call - FREE model)
# Use MODE=ZAI_DIRECT to enable this mode
ZAI_DIRECT_MODEL=glm-4.6v-flash
ZAI_DIRECT_BASE_URL=https://api.z.ai/api/paas/v4

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:27b-it-q4_K_M

# LM Studio (Local)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-3-27b

# LLM Mode Selection (set from command line or here)
# Options: OPENAI, GEMINI, OLLAMA, LMSTUDIO, GROQ, TOGETHER, GROK, ANTHOPIC, ZAI, ZAI_DIRECT
MODE=ZAI

# Additional Configuration
REASONING_EFFORT=low
ONE_IMAGE_PER_PROMPT=true
MINIMAP_ENABLED=true
MINIMAP_2D=true
REASONING_ENABLED=true
MAX_TOKENS=2048
TEMPERATURE=0.7
IMAGE_DETAIL=low

# ═══════════════════════════════════════════════════════════════════════════
# CHAT RESPONSE API (separate from main LLM)
# ═══════════════════════════════════════════════════════════════════════════
# Required for real chat responses - uses LLM to generate witty replies
# Uses Featherless AI for local/development, Alkahest for production
#
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=zai-org/GLM-4.6

# Alkahest AI (Production - our internal AI router)
ALKAHEST_API_KEY=your_alkahest_api_key_here
ALKAHEST_BASE_URL=https://api.alkahest.ai/v1
ALKAHEST_MODEL=zai-org/GLM-4.6

# ═══════════════════════════════════════════════════════════════════════════
# COMFYUI TEXT-TO-SPEECH (ChatterBox TTS)
# ═══════════════════════════════════════════════════════════════════════════
# Local: http://localhost:8188
# Development (Cloudflare protected): https://comfyui.testarea.app
# Production: https://comfyui.alkahest.app
#
TTS_ENABLED=true
COMFYUI_URL=https://comfyui.testarea.app
COMFYUI_TTS_WORKFLOW=workflows/lass-tts.json
COMFYUI_OUTPUT_DIR=tts_output

# ComfyUI Basic Auth (if protected by Cloudflare or reverse proxy)
COMFYUI_USERNAME=
COMFYUI_PASSWORD=

# TTS Audio Post-Processing (requires ffmpeg: brew install ffmpeg)
# Speed: 1.0 = normal, 1.1 = 10% faster, 1.2 = 20% faster
# Pitch: semitones shift (0 = no change, 2 = 2 semitones higher, -2 = 2 lower)
TTS_AUDIO_SPEED=1.1
TTS_AUDIO_PITCH=2

# ═══════════════════════════════════════════════════════════════════════════
# TWITCH CHAT INTEGRATION
# ═══════════════════════════════════════════════════════════════════════════
# Real Twitch integration requires twitchio: pip install twitchio
# Get OAuth token from: https://twitchtokengenerator.com/
#
TWITCH_BOT_USERNAME=Lass
TWITCH_OAUTH_TOKEN=oauth:your_token_here
TWITCH_CHANNEL=LLMLetsPlay

# ═══════════════════════════════════════════════════════════════════════════
# ═══════════════════════════════════════════════════════════════════════════
# Generates fake Pokemon-themed chat messages for testing SKIP/RESPOND system
# Works OFFLINE without any Twitch or API keys!
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=
TWITCH_CHANNEL=

# Chat Test Mode (Simulates users for both Twitch and Pump.fun)
CHAT_TEST_MODE=true
CHAT_TEST_MESSAGES_PER_CYCLE=3

# Chat LLM Configuration
# CHAT_TEST_LLM=true: Use real LLM even for test messages (vs generic test responses)
# CHAT_LLM_PROVIDER: featherless (local/dev) or alkahest (prod)
CHAT_TEST_LLM=true
CHAT_LLM_PROVIDER=featherless

# Twitch Engagement Features
TWITCH_ENABLE_POLLS=false
TWITCH_ENABLE_CHANNEL_POINTS=false
TWITCH_ENABLE_PREDICTIONS=false
TWITCH_ENABLE_CHAT_MEMORY=true

# ═══════════════════════════════════════════════════════════════════════════
# PUMP.FUN LIVESTREAM CHAT - Crypto token chat integration
# ═══════════════════════════════════════════════════════════════════════════
# Connects to pump.fun token chat rooms via WebSocket
# Reading messages: No auth required
# Sending messages: Requires pump.fun session cookies (not implemented yet)
#
# PUMPFUN_TOKEN_ADDRESS: Your token's contract address on pump.fun
# Example: y31hFyYbrVW4R53Zfka8WJfQpwpMLfCcAjVKAonpump
#
PUMPFUN_TOKEN_ADDRESS=
PUMPFUN_COOKIE=

# ═══════════════════════════════════════════════════════════════════════════
# TOKEN TEST MODE - For development/testing without live $LASS token
# ═══════════════════════════════════════════════════════════════════════════
# Use a test token for local development. When enabled, uses TOKEN_TEST_ADDRESS
# instead of PUMPFUN_TOKEN_ADDRESS for all token operations.
#
# Test token: kabuto on pump.fun
TOKEN_TEST_MODE=false
TOKEN_TEST_ADDRESS=A9E2AopuG56LWYiXsvGLLTcLjUjQ539PY6k5Fhfepump


# ═══════════════════════════════════════════════════════════════════════════
# CHAT RESPONSE PRIORITY HIERARCHY
# ═══════════════════════════════════════════════════════════════════════════
# When multiple chat messages come in, priority order is:
#
# 1. 👑 Pump.fun WHALE holders (100k+ tokens) - Highest priority
# 2. 💎 Twitch subscribers
# 3. 🪙 Regular pump.fun chatters
# 4. 👤 Regular Twitch chatters - Lowest priority
#
# Token threshold for whale status (set to 0 to disable whale priority):
PUMPFUN_WHALE_THRESHOLD=100000

# Cache TTL for whale status (in seconds)
# Longer = fewer API calls but slower to detect balance changes
# Default 15 min (900s) is good for streams since users stick around
WHALE_CACHE_TTL=900

# ═══════════════════════════════════════════════════════════════════════════
# SOLANA RPC PROVIDERS - For whale detection (token balance queries)
# ═══════════════════════════════════════════════════════════════════════════
# Uses multi-provider fallback with FREE tiers to minimize costs.
# Order of fallback: Helius → Alchemy → Shyft → QuickNode → Public RPC
#
# FREE TIER LIMITS (as of 2024):
# - Helius:    1M credits/month, 10 req/sec  (https://helius.dev)
# - Alchemy:   30M CUs/month, 500 CUPs       (https://alchemy.com)
# - Shyft:     Unlimited credits, 10 req/sec (https://shyft.to)
# - QuickNode: Free tier available           (https://quicknode.com)
# - Public:    https://api.mainnet-beta.solana.com (40 req/10sec, shared)
#
# HOW REQUESTS WORK:
# - Each unique pump.fun chatter wallet = 1 RPC call
# - Cache TTL = 15 minutes (same user = 0 calls within 15 min)
# - Only pump.fun messages (not Twitch) trigger API calls
#
# DAILY ESTIMATE (30s cycles, 2,880 cycles/day, 15 min cache):
# - Best case (mostly returning users): ~50-200 calls/day
# - Avg case (mix of new/returning):    ~300-1,000 calls/day
# - Worst case (all new users):         ~1,500-3,000 calls/day
#
# With multiple providers, you can spread load across free tiers.
# Even worst case fits comfortably in combined free limits.
#
# Get free API keys:
# - Helius:    https://helius.dev/dashboard
# - Alchemy:   https://dashboard.alchemy.com
# - Shyft:     https://shyft.to/get-api-key
# - QuickNode: https://quicknode.com
#
HELIUS_API_KEY=
ALCHEMY_SOLANA_API_KEY=
SHYFT_API_KEY=
QUICKNODE_SOLANA_URL=

# Public RPC fallback (no key needed, but rate limited)
# Used automatically if all other providers fail
# SOLANA_PUBLIC_RPC=https://api.mainnet-beta.solana.com