# WalletConnect Project ID (Get from cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=

# The Backend API URL
VITE_CHRONICLE_API_URL=http://localhost:3001

# Admin Security
# The wallet address allowed to view the Admin UI.
# IMPORTANT: This must match ADMIN_WALLET_ADDRESS in the server .env
# Write operations are cryptographically verified against this address on the server.
VITE_ADMIN_WALLET=0x...

# Zora Configuration (Used for display links)
VITE_ZORA_CREATOR_ADDRESS=0x...
