# Server Configuration
PORT=3001
# Path to store exclusive/gated content (not accessible via public URL)
SECURE_STORAGE_PATH=./secure_storage

# Zora / Blockchain Configuration
# The private key used to mint new drops on Zora (Base Network)
ZORA_PRIVATE_KEY=0x...
# The public address associated with the private key (Creator)
ZORA_CREATOR_ADDRESS=0x...
# RPC URL for Base (Optional, defaults to public endpoints)
BASE_RPC_URL=https://mainnet.base.org
# Chain ID: 8453 for Base Mainnet, 84532 for Base Sepolia (Testnet)
CHAIN_ID=8453

# Security & Authorization
# The wallet address authorized to access the Admin Panel and perform write operations.
# Must match VITE_ADMIN_WALLET in the frontend.
# If not set, defaults to ZORA_CREATOR_ADDRESS.
ADMIN_WALLET_ADDRESS=0x...

# API Key for Python Agent (Internal Service Auth)
# Generate a strong random string (e.g. `openssl rand -hex 32`)
CHRONICLE_SECRET_KEY=change_me_to_a_secure_random_string

# Twitter / X Integration (for Cross-posting)
# Get these from the Twitter Developer Portal
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
